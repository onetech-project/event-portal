# Copy to .env and adjust. Loaded at startup by godotenv, but only as a local
# convenience: any variable already set in the real environment wins, so this
# file can never override a container's injected configuration.
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Required.
DATABASE_URL=postgres://ticketing:ticketing@localhost:5433/ticketing?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h

# --- Payment gateway (Manjo) -------------------------------------------------
# Required, with no compiled-in default: there is no environment selector, so
# nothing here can recognise a stale address. Point it at a stub to exercise the
# full purchase flow offline — that is the ordinary way to run it, not a special
# test mode.
PG_BASE_URL=http://localhost:10327
# Sent in the session-open body as ac.cr.{client_id,client_secret}. The gateway
# checks they are present, not what they are, so any non-empty string works
# locally. They still must never reach a log or a guest-facing response.
PG_SERVER_KEY=local-server-key
PG_CLIENT_KEY=local-client-key
# The bearer token the gateway presents on POST /v1.0/callback/exec. This side
# issues it; the gateway is configured with the same value. A mismatch is the
# only case where the callback answers non-200.
PG_CALLBACK_TOKEN=change-me-to-a-long-random-string

# How often abandoned orders past their deadline are expired and their reserved
# quota returned to the ticket types.
PAYMENT_SWEEP_INTERVAL=30s

# How long a booked order holds its seats before the guest must start payment.
# The expiry sweeper reclaims lapsed holds through the same deadline column.
BOOKING_HOLD=1h
# NOT the payment deadline any more — the gateway returns that (qr_ea) and it is
# adopted verbatim. This value survives only as two things: the fallback used
# when no usable expiry came back (which also raises a signal), and the
# expectation an adopted expiry is compared against so a materially different
# one is noticed.
PAYMENT_WINDOW=15m

# SMTP. Defaults suit the Mailpit container in docker-compose (UI on :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=tickets@example.com
SMTP_FROM_NAME=Event Ticketing

# --- Request throttling (Constitution Principle IX) --------------------------
# Every threshold below defaults to the value that used to be compiled into the
# binary, so a deployment that sets none of these behaves exactly as before.
# Read at startup: changing one needs a restart, never a rebuild.

# THE KILL SWITCH. false takes all six throttled surfaces out of the request
# path. Know what that leaves exposed, because all of it is unauthenticated:
#   - booking creates rows and holds quota for an hour without payment
#   - checkout opens a real, billable payment-gateway session per press
#   - the guest resend sends real mail to a buyer's inbox
#   - the status-stream cap is the ONLY bound on held-open connections per
#     client, and every held connection also re-reads the database periodically,
#     so with it off both are unbounded
RATE_LIMIT_ENABLED=true

# How long untouched per-key state is kept. ONE value shared by every surface
# that retains state. It MUST exceed the longest window it retains — the time to
# refill a full burst — or an exhausted client is evicted before it refills and
# comes back with a clean slate, which makes the limit look like it works while
# enforcing nothing. Startup refuses if it is too short and names the value that
# would work.
RATE_LIMIT_IDLE_TTL=3m

# Booking: roughly one every three seconds, with headroom for a real group
# organizing itself. 0.33 is deliberate and is not 1/3.
RATE_LIMIT_BOOK_ENABLED=true
RATE_LIMIT_BOOK_RATE=0.33
RATE_LIMIT_BOOK_BURST=5

# Availability check: looser than booking on purpose. It creates nothing, and a
# refused guest re-checks after adjusting their selection — charging that to the
# booking budget would throttle them out of the recovery path it exists to offer.
RATE_LIMIT_AVAILABILITY_ENABLED=true
RATE_LIMIT_AVAILABILITY_RATE=1.0
RATE_LIMIT_AVAILABILITY_BURST=10

# Public ticket lookup, so enumerating ticket codes is impractical (spec FR-020).
RATE_LIMIT_TICKET_LOOKUP_ENABLED=true
RATE_LIMIT_TICKET_LOOKUP_RATE=5
RATE_LIMIT_TICKET_LOOKUP_BURST=10
# DEPRECATED names for the two above. Still honoured so a deployment that already
# tuned them keeps its values; the RATE_LIMIT_* name wins when both are set, and
# using these logs a notice at startup.
#TICKET_LOOKUP_RATE_LIMIT=5
#TICKET_LOOKUP_BURST=10

# Checkout: the tightest limit here, because every press costs an outbound
# gateway call. One every five seconds, plus an impatient double-tap.
RATE_LIMIT_CHECKOUT_ENABLED=true
RATE_LIMIT_CHECKOUT_RATE=0.2
RATE_LIMIT_CHECKOUT_BURST=3

# Free registration (spec 022) — /event/:slug/register/:id submissions.
#
# BLAST RADIUS OF DISABLING THIS (Principle IX requires it be stated):
# this endpoint is UNAUTHENTICATED, DEDUCTS QUOTA and SENDS REAL EMAIL to an
# address the caller chooses. It is reached through an unlisted-but-not-secret
# link, so anyone holding that link can drive it.
#
# It is also the ONLY volume bound that exists. Spec 022 FR-023 removed the
# one-email-per-event rule, so nothing else limits how many times one address —
# or one caller — may submit. Turning this off, or turning off the master
# RATE_LIMIT_ENABLED, leaves quota and the sales window as the sole protection
# for an invitation allocation, and leaves a stranger's inbox reachable in a loop.
#
# The rate matches checkout (one every five seconds sustained, 12/min).
# The BURST deliberately does not: registering a group means submitting this form
# once per person from one device, so a burst of 3 would refuse the fourth guest.
# 10 clears a realistic group in one sitting without loosening the sustained
# ceiling. Raise the burst for larger groups; leave the rate alone unless you mean
# to loosen the abuse bound. Burst/rate is the full-refill time (50s here) and
# MUST stay under RATE_LIMIT_IDLE_TTL — startup refuses a config where it does not.
RATE_LIMIT_REGISTER_ENABLED=true
RATE_LIMIT_REGISTER_RATE=0.2
RATE_LIMIT_REGISTER_BURST=10

# Guest ticket-email resend. Keyed per ORDER, not per client: the inbox being
# protected is the buyer's, and a per-client limit would let a few hosts flood
# one buyer between them. GUEST-VISIBLE — this window is what the confirmation
# screen counts down from and what a refusal reports, so changing it changes what
# guests are told, not only what they are allowed.
RATE_LIMIT_RESEND_ENABLED=true
RATE_LIMIT_RESEND_WINDOW=60s
RATE_LIMIT_RESEND_BURST=1

# Live payment-status stream: a ceiling on CONCURRENT held-open connections per
# client, not a request rate, so it takes no allowance and no burst.
RATE_LIMIT_STATUS_STREAM_ENABLED=true
RATE_LIMIT_STATUS_STREAM_MAX_CONNS=10

# Where the client address comes from, and so what every per-client throttle is
# keyed on. Empty — the default — takes it from the connection and IGNORES
# X-Forwarded-For, because a limit keyed on a header any caller can set is not a
# limit. Set this ONLY if the API genuinely sits behind a proxy you control; the
# header is then trusted from those addresses alone.
#
# CHANGING THIS CHANGES BEHAVIOUR: a deployment already behind a proxy that does
# not set this will see all its clients collapse onto the proxy's address and
# share one bucket. That is the correct failure direction — too strict, not
# bypassable — but it is a real change, so declare your proxy here.
TRUSTED_PROXY_CIDRS=

# --- Observability -----------------------------------------------------------
# Identity attached to every span and log line.
OTEL_SERVICE_NAME=ticketing-api
SERVICE_VERSION=dev
ENVIRONMENT=local

# Collector address (Grafana Alloy). Empty disables trace export; incoming trace
# context is still propagated either way. Set to alloy:4317 when running with
# the observability stack.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Head-sampling probability, 0..1.
OTEL_TRACES_SAMPLER_ARG=1.0

# Exposes GET /metrics for Prometheus.
METRICS_ENABLED=true

# --- Read cache (Constitution Principle VII) ---------------------------------
# Redis caches the list endpoints only — event, ticket type, package, order and
# attendee lists — and is refreshed whenever a write commits, not on a timer.
# It is a soft dependency: with Redis down every read falls back to Postgres and
# the API keeps serving, reporting "degraded" on /healthz.
#
# Inside docker compose this is redis://redis:6379/0. An empty value disables the
# cache exactly like CACHE_ENABLED=false.
REDIS_URL=redis://localhost:6379/0

# The kill switch. false returns the API to a direct database read on every
# request, with no other behavioural difference.
CACHE_ENABLED=true

# Backstop expiry on every cached entry. This is NOT how the cache stays fresh —
# writes invalidate on commit. It only bounds the damage of an invalidation that
# was somehow missed.
CACHE_TTL=10m
