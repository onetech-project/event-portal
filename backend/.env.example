# Copy to .env and adjust. Loaded at startup by godotenv, but only as a local
# convenience: any variable already set in the real environment wins, so this
# file can never override a container's injected configuration.
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Required.
DATABASE_URL=postgres://ticketing:ticketing@localhost:5433/ticketing?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h

# Midtrans Core API (sandbox by default, per PRD 1.2). QRIS is charged through
# the Core API, whose host is api.sandbox.midtrans.com — NOT the app.sandbox host
# the old SNAP redirect used.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Overrides the Core API endpoint. Leave empty in real use; point it at a stub to
# exercise the full purchase flow offline.
MIDTRANS_BASE_URL=

# How long a QRIS code stays payable. 15m is the provider's own default and its
# documented floor: below it, the provider's expiry scheduler is unreliable and
# startup rejects the value.
PAYMENT_EXPIRY=15m
# How often abandoned orders past their deadline are expired and their reserved
# quota returned to the ticket types.
PAYMENT_SWEEP_INTERVAL=30s

# How long a booked order holds its seats before the guest must start payment.
# The expiry sweeper reclaims lapsed holds through the same deadline column.
BOOKING_HOLD=1h
# Server-owned payment deadline stamped at checkout. Must be strictly shorter
# than PAYMENT_EXPIRY (the gateway-side QR validity).
PAYMENT_WINDOW=14m
# When the client swaps in a fresh QR during the payment window. Frontend timer
# only. Must be strictly shorter than PAYMENT_WINDOW.
QR_REFRESH_AFTER=7m

# SMTP. Defaults suit the Mailpit container in docker-compose (UI on :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=tickets@example.com
SMTP_FROM_NAME=Event Ticketing

# Per-IP limit on the public ticket lookup (spec FR-020).
TICKET_LOOKUP_RATE_LIMIT=5
TICKET_LOOKUP_BURST=10

# --- Observability -----------------------------------------------------------
# Identity attached to every span and log line.
OTEL_SERVICE_NAME=ticketing-api
SERVICE_VERSION=dev
ENVIRONMENT=local

# Collector address (Grafana Alloy). Empty disables trace export; incoming trace
# context is still propagated either way. Set to alloy:4317 when running with
# the observability stack.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Head-sampling probability, 0..1.
OTEL_TRACES_SAMPLER_ARG=1.0

# Exposes GET /metrics for Prometheus.
METRICS_ENABLED=true

# --- Read cache (Constitution Principle VII) ---------------------------------
# Redis caches the list endpoints only — event, ticket type, package, order and
# attendee lists — and is refreshed whenever a write commits, not on a timer.
# It is a soft dependency: with Redis down every read falls back to Postgres and
# the API keeps serving, reporting "degraded" on /healthz.
#
# Inside docker compose this is redis://redis:6379/0. An empty value disables the
# cache exactly like CACHE_ENABLED=false.
REDIS_URL=redis://localhost:6379/0

# The kill switch. false returns the API to a direct database read on every
# request, with no other behavioural difference.
CACHE_ENABLED=true

# Backstop expiry on every cached entry. This is NOT how the cache stays fresh —
# writes invalidate on commit. It only bounds the damage of an invalidation that
# was somehow missed.
CACHE_TTL=10m
