# Copy to `.env.uat` and fill in. Read only when E2E_TARGET=uat, which
# `npm run test:uat` sets — the local suite never sees this file, and this
# profile never touches a database.
#
# Unlike .env, nothing here has a default. A deployment cannot be guessed, and a
# fallback to localhost would run the whole suite against a dev stack and report
# the deployment healthy. Every value below is required; the run fails naming
# the first one missing.
#
# THIS FILE'S REAL COUNTERPART HOLDS SECRETS. .env.uat is gitignored — keep it
# that way, and never paste the callback token into a spec, a ticket, or a chat.

# Where the browser goes.
E2E_FRONTEND_URL=https://uat-jive.manjo.co.id

# Where the API answers. Note these are the API host — NOT the frontend host.
# A wrong E2E_API_ROOT_URL is silent until settlement: /v1.0/callback/exec would
# land on the frontend and 404 with everything else looking fine.
E2E_API_URL=https://uat-api-jive.manjo.co.id/api/v1
E2E_API_ROOT_URL=https://uat-api-jive.manjo.co.id

# An admin that ALREADY EXISTS on the deployment. This profile signs in; it
# never creates an admin, and there is no password hash to set.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# The deployment's own PG_CALLBACK_TOKEN. This is the whole of the payment
# callback's authentication, so it is a genuine secret: with it, the suite can
# settle an order the way the gateway would. Without it, settlement cannot be
# driven and the purchase spec cannot pass.
E2E_PG_CALLBACK_TOKEN=

# Prefix for every event and buyer this run creates there, so the residue is
# identifiable and greppable. Change it if a deployment is shared by several
# teams running this suite.
# E2E_UAT_PREFIX=uat-e2e

# Milliseconds paused before each browser operation; timeouts scale with it.
# `npm run test:uat:slow` sets 500 for a watched run.
# E2E_SLOW_MO=0
