# Copy to `.env` to override the defaults in support/env.ts.
#
# Precedence is shell > .env > built-in defaults, so an inline
# `E2E_SLOW_MO=500 npm test` still wins over anything written here.
#
# Everything is optional: with no .env at all the suite points at a stock
# `docker compose up` plus the two dev servers. Nothing here is a secret —
# these values only ever address a disposable local stack.

# Where the browser goes and where the API answers.
# E2E_FRONTEND_URL=http://localhost:3100
# E2E_API_URL=http://localhost:8100/api/v1
# E2E_API_ROOT_URL=http://localhost:8100
# E2E_GATEWAY_URL=http://localhost:8101

# The suite TRUNCATEs this database on every run, and refuses any host that is
# not local — see assertDisposableDatabase in support/env.ts.
# E2E_DATABASE_URL=postgres://ticketing:ticketing@localhost:5433/ticketing?sslmode=disable
# E2E_REDIS_URL=redis://localhost:6380/0

# Payment stub credentials. The callback token is the whole of the webhook's
# authentication; the key pair is vestigial and grants nothing.
# E2E_PG_CALLBACK_TOKEN=uat-e2e-callback-token
# E2E_PG_SERVER_KEY=uat-e2e-server-key
# E2E_PG_CLIENT_KEY=uat-e2e-client-key
# E2E_JWT_SECRET=uat-e2e-jwt-secret-long-enough-for-hs256

# Seeded admin. The hash is bcrypt of the password — regenerate both together.
# E2E_ADMIN_EMAIL=uat@example.com
# E2E_ADMIN_PASSWORD=uat-password-2026
# E2E_ADMIN_PASSWORD_HASH=$2a$10$CgCyUAfad.aCAZ4LTyZL1..x1ptoMhQ3GpEMnyy.BKDzV/aFMYVpu

# Set false to prove Principle VII's cache kill switch. The suite must pass both ways.
# E2E_CACHE_ENABLED=true

# Milliseconds paused before every browser operation; timeouts scale with it.
# E2E_SLOW_MO=0

# Set false when the servers are already running and the suite should not start them.
# E2E_MANAGE_SERVERS=true

# Mailpit, if it is up.
# E2E_SMTP_HOST=localhost
# E2E_SMTP_PORT=1025
