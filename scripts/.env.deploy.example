# Copy to scripts/.env.deploy and fill in. That file is gitignored.
#
#   cp scripts/.env.deploy.example scripts/.env.deploy

# --- container registry ---
REGISTRY_PATH=registry.example.com/jive
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- target environment ---
# uat or prod. Selects frontend/.env.<name>, which the deploy ships to the
# server as the frontend's runtime config. The --env flag overrides it.
#
# Nothing is baked into the frontend image, so the build does not need this —
# only the deploy does. That is the point: one image is built, and the same
# image is promoted from uat to prod with a different .env beside it.
APP_ENV=uat

# --- image tags ---
# Left unset, both default to $APP_ENV — so uat and prod get distinct tags
# instead of fighting over :latest. Uncomment only to pin an explicit tag.
#TAG_FE=
#TAG_BE=

# Image names.
FE_IMAGE_NAME=jive-fe
BE_IMAGE_NAME=jive-be

# The compose service to pull and restart on the server. Defaults to the image
# name above; set these only if the remote compose file names them differently.
#FE_SERVICE=
#BE_SERVICE=

# --- how the tag reaches the server ---
# Each remote compose file takes its image from two variables:
#
#   services:
#     jive-be:
#       image: ${IMAGE_NAME}:${IMAGE_TAG}
#
# and reads them from the .env sitting next to it. The deploy owns those two
# keys: before pulling it rewrites them in that .env — every other line of the
# file is left alone — and exports them for its own compose commands, so the
# server runs $REGISTRY_PATH/$BE_IMAGE_NAME:$TAG_BE and stays on it across a
# reboot or a hand-run `docker compose up -d`.
#
# A service that resolves to some other image aborts the deploy before anything
# on the server is written or pulled. Pass --no-image-check to deploy the tag
# its compose file pins anyway, or --no-remote-env to leave the .env untouched
# (that run still deploys the right tag; a later restart would not).
#
# Only set these if a compose file uses different variable names.
#REMOTE_IMAGE_NAME_VAR=IMAGE_NAME
#REMOTE_IMAGE_TAG_VAR=IMAGE_TAG

# --- how the frontend is configured on the server ---
# The frontend image is environment-agnostic: API_BASE_URL and the QRIS identity
# are read when the container starts, not compiled into the bundle. The deploy
# merges frontend/.env.$APP_ENV into $REMOTE_FE_DIR/.env by the same rule it
# uses for the image keys — each name rewritten in place, every other line left
# alone — so the setting survives a restart rather than only this run.
#
# The remote frontend service has to actually pass those names into the
# container, which compose does not do just because they are in .env:
#
#   services:
#     jive-fe:
#       image: ${IMAGE_NAME}:${IMAGE_TAG}
#       env_file:
#         - .env
#
# A service that never receives them aborts the deploy, because the app would
# otherwise come up on its built-in localhost default and fail in the browser
# rather than here. Pass --no-env-check to deploy anyway, or --no-frontend-env
# to leave the server's existing config untouched.
#
# Set FRONTEND_ENV_FILE only to point somewhere other than frontend/.env.$APP_ENV.
#FRONTEND_ENV_FILE=

# --- remote server ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Leave SSH_PASSWORD empty to use key-based auth (recommended).
# If set, sshpass must be installed locally.
SSH_PASSWORD=

# Directories on the server holding each docker-compose.yml.
REMOTE_FE_DIR=/opt/jive/frontend
REMOTE_BE_DIR=/opt/jive/backend

# --- migrations ---
# Uploaded before the stack comes up, because they are bind-mounted into the
# migrate/migrate container rather than baked into the backend image.
# Defaults to <repo>/backend/migrations -> $REMOTE_BE_DIR/migrations.
#LOCAL_MIGRATIONS_DIR=
#REMOTE_MIGRATIONS_DIR=

# --- read cache (Constitution Principle VII) ---
# This script pulls and restarts the application images only; it does not own the
# remote service definitions. The backend now expects a Redis alongside Postgres,
# so the remote compose file at $REMOTE_BE_DIR needs:
#
#   redis:
#     image: redis:7-alpine
#     command: ["redis-server","--save","","--appendonly","no",
#               "--maxmemory","256mb","--maxmemory-policy","allkeys-lru"]
#
# and the backend service needs REDIS_URL / CACHE_ENABLED / CACHE_TTL (see
# backend/.env.example). Deliberately NOT a depends_on: Redis is a soft
# dependency and the API must start and serve without it.
#
# Deploying without doing this is safe — every read falls back to Postgres and
# /healthz reports "degraded" rather than failing.
